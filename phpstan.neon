includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - packages/ai/src
        - packages/chat/src
        - packages/cms/src
        - packages/forms/src
        - packages/mcp/src
        - packages/page-builder/src
        - packages/parts/src
        - packages/seo/src
        - packages/site/src
        - packages/ui/src
    # Larastan reads a model's columns from the migrations, which live in the
    # package rather than in an app's database/ directory.
    databaseMigrationsPath:
        - packages/ai/database/migrations
        - packages/cms/database/migrations
