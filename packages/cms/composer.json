{
    "name": "mainstay/cms",
    "description": "A CMS for Laravel: content modelled in PHP, edited in a Blade admin, rendered by the host app's Blade views or served headless over a REST and MCP API.",
    "keywords": ["laravel", "cms", "headless", "content"],
    "license": "MIT",
    "homepage": "https://mainstaycms.org",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "laravel/ai": "^1.3",
        "laravel/mcp": "^1.1",
        "mainstay/ui": "self.version",
        "spatie/image": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Mainstay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mainstay\\MainstayServiceProvider"
            ],
            "aliases": {
                "Mainstay": "Mainstay\\Facades\\Mainstay"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
